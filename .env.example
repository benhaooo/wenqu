# 复制为 .env 后按需修改。.env 不进仓库。

# PostgreSQL（docker-compose 与后端共用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wenqu
DB_USERNAME=wenqu
DB_PASSWORD=change-me

# 登录鉴权
# JWT 签名密钥，至少 32 个字符，可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Token 有效期（ISO-8601），调试自动刷新时可把 ACCESS_TOKEN_TTL 改短，如 PT30S
ACCESS_TOKEN_TTL=PT2H
REFRESH_TOKEN_TTL=P7D
# 部署在 HTTPS 下时设为 true
AUTH_COOKIE_SECURE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# RabbitMQ（管理界面 http://localhost:15672）
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=wenqu
RABBITMQ_PASSWORD=change-me

# MinIO（控制台 http://localhost:9001，账号即下面的 access/secret key）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wenqu
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=wenqu

# 本地端口
BACKEND_PORT=8080
FRONTEND_PORT=5173
