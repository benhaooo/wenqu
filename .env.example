# 复制为 .env 后按需修改。.env 不进仓库。

# PostgreSQL（docker-compose 与后端共用）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wenqu
DB_USERNAME=wenqu
DB_PASSWORD=change-me

# 登录鉴权
# JWT 签名密钥，至少 32 个字符，可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Token 有效期（ISO-8601），调试自动刷新时可把 ACCESS_TOKEN_TTL 改短，如 PT30S
ACCESS_TOKEN_TTL=PT2H
REFRESH_TOKEN_TTL=P7D
# 部署在 HTTPS 下时设为 true
AUTH_COOKIE_SECURE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# RabbitMQ（管理界面 http://localhost:15672）
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=wenqu
RABBITMQ_PASSWORD=change-me

# MinIO（控制台 http://localhost:9001，账号即下面的 access/secret key）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
# 浏览器访问图片签名链接的地址，部署时设为对外可访问的 MinIO 地址；留空则与 MINIO_ENDPOINT 相同
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wenqu
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=wenqu

# 对话模型（OpenAI 兼容接口）。修改后重启后端生效
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_API_KEY=change-me
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_TEMPERATURE=0.2
# 单次回答的最长时间
AI_CHAT_TIMEOUT=PT120S

# Embedding 模型（OpenAI 兼容接口），可以与对话模型来自不同服务
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=change-me
AI_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度：必须与模型实际返回的维度一致（启动时检查），不超过 2000；
# 只在首次建库时生效，修改后需要 make db-reset 并重新导入，更换模型后在设置页「重新索引全部文档」
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_TIMEOUT=PT30S

# 检索与切块（一般不用改）
# 每次问答检索的文本块数
RETRIEVAL_TOP_K=8
# 余弦相似度低于该值的文本块视为不相关，全部不相关时直接回复没有找到
RETRIEVAL_MIN_SIMILARITY=0.35
# 每个文本块的 token 上限与相邻块重叠，修改后对新索引的文档生效
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# 本地端口
BACKEND_PORT=8080
FRONTEND_PORT=5173
